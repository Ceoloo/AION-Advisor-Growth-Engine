{
  "name": "aion-advisor-growth-engine",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered lead generation, client management, and sales automation for financial advisors and insurance professionals — a modular intelligence and experience layer on top of GoHighLevel.",
  "author": "AION",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "seed": "tsx scripts/seed-demo.ts",
    "hooks:install": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,md,json}": "prettier --write"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
