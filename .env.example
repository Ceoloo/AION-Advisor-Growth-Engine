# =============================================================================
# AION Advisor Growth Engine — Environment Configuration
# =============================================================================
# Copy this file to `.env` (and `.env.local` for the web app) and fill values.
# NEVER commit real secrets. All variables are validated at startup by
# packages/shared (see packages/shared/src/env.ts). Missing required values
# in production will halt the process; in development sensible fallbacks are
# used so the demo can run without external services.
# -----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# When true, the platform runs entirely on seeded demo data and blocks
# destructive/outbound production actions. Great for sales demos.
DEMO_MODE=true

# --- Database (Supabase Postgres) --------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-side only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- GoHighLevel (CRM backend) -----------------------------------------------
GHL_CLIENT_ID=your-ghl-client-id
GHL_CLIENT_SECRET=your-ghl-client-secret
GHL_REDIRECT_URI=http://localhost:3000/api/integrations/ghl/callback
# HMAC secret used to verify inbound GHL webhooks.
GHL_WEBHOOK_SECRET=your-ghl-webhook-secret
# Base URL for the GHL REST API (v2).
GHL_API_BASE_URL=https://services.leadconnectorhq.com

# --- AI Layer (provider-agnostic gateway) ------------------------------------
# One of: mock | openai | anthropic
AI_PROVIDER=mock
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_MODEL=claude-sonnet-4-5

# --- Communications (optional; GHL is used first) ----------------------------
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TELNYX_API_KEY=your-telnyx-api-key
SENDGRID_API_KEY=your-sendgrid-api-key
MAILGUN_API_KEY=your-mailgun-api-key

# --- Payments (optional) -----------------------------------------------------
STRIPE_SECRET_KEY=your-stripe-secret-key

# --- Observability -----------------------------------------------------------
SENTRY_DSN=your-sentry-dsn
POSTHOG_KEY=your-posthog-key
POSTHOG_HOST=https://us.i.posthog.com
LOG_LEVEL=info

# --- Security ----------------------------------------------------------------
# 32-byte key (base64 or hex) used to encrypt integration credentials at rest.
ENCRYPTION_KEY=change-me-to-a-32-byte-random-string
# Shared secret required by cron/worker trigger endpoints.
CRON_SECRET=change-me-cron-secret

# --- Airtable (Revenue & CRM OS) — SERVER-SIDE ONLY --------------------------
# The token is a SECRET and must never be exposed to the browser. All Airtable
# writes happen server-side. In demo mode (DEMO_MODE=true) no records are written
# even if a token is present. The IDs below are safe defaults for the AION base.
AIRTABLE_ACCESS_TOKEN=your-airtable-personal-access-token
AIRTABLE_API_BASE_URL=https://api.airtable.com/v0
AIRTABLE_BASE_ID=appezuvIZLMwAFnFB
AIRTABLE_LEADS_TABLE_ID=tblHxq81EcZtduR5T
AIRTABLE_SCORECARD_RESPONSES_TABLE_ID=tbl73qC0rKOwZwMCu
AIRTABLE_INTENT_EVENTS_TABLE_ID=tblvhrV2lgbrZ3Ch8
AION_FINANCIAL_ADVISOR_CAMPAIGN_RECORD_ID=recfZeWhsImzp0Cxc
AION_ADVISOR_SCORECARD_ASSET_RECORD_ID=recZqIoAntR6njY4N

# --- Booking (Advisor Growth Review) ----------------------------------------
# Provider-agnostic scheduling URL. When unset, the results page shows a
# graceful "booking coming soon" state and still records booking intent.
ADVISOR_GROWTH_REVIEW_URL=https://cal.com/your-handle/advisor-growth-review
