{
  "key": "new_lead",
  "name": "New Lead Workflow",
  "description": "Normalize, dedupe, sync to GHL, qualify, score, route, and begin nurture.",
  "trigger": "lead.created",
  "steps": [
    { "id": "normalize", "action": "normalize_data", "label": "Normalize Data" },
    { "id": "dedupe", "action": "check_duplicate", "label": "Check Duplicate" },
    { "id": "ghl_sync", "action": "ghl_upsert_contact", "label": "Add to GoHighLevel", "retry": { "maxAttempts": 3, "backoffMs": 500 } },
    { "id": "source", "action": "assign_lead_source", "label": "Assign Lead Source" },
    { "id": "qualify", "action": "start_ai_qualification", "label": "Start AI Qualification" },
    { "id": "score", "action": "calculate_lead_score", "label": "Calculate Lead Score" },
    { "id": "pipeline", "action": "add_to_pipeline", "label": "Add to Pipeline" },
    { "id": "notify", "action": "notify_advisor", "label": "Notify Assigned Advisor" },
    { "id": "nurture", "action": "start_nurture", "label": "Begin Nurture Sequence" }
  ]
}
